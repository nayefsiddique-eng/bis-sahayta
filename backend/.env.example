# ─────────────────────────────────────────────────────────────────────────────
# BIS Compliance & Intelligence Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# API key required in X-API-Key header for all endpoints except /health and /ready
API_KEY=demo-key-123

# ── Debug / Logging ───────────────────────────────────────────────────────────
DEBUG=false

# ── Bhashini Translation ──────────────────────────────────────────────────────
# Get credentials at: https://bhashini.gov.in/ulca/user-profile
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock (default) | gemini | ollama
LLM_PROVIDER=mock

# Gemini (requires google-generativeai package)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama (requires Ollama running locally: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Multi-Model LLM Routing ───────────────────────────────────────────────────
# Controls automatic fallback from Gemini to self-hosted open-weight models.
# When Gemini hits a quota/rate-limit the router will try local models in order.
#
# Which model to prefer: auto | gemini | gemma4 | qwen
LLM_DEFAULT_MODEL=gemini
# Comma-separated fallback order when the primary model fails
LLM_FALLBACK_ORDER=gemma4,qwen
# HTTP timeout for local model calls (seconds)
LLM_REQUEST_TIMEOUT_SECONDS=30
# Max concurrent requests to local models (protects GPU memory)
LLM_LOCAL_MAX_CONCURRENCY=2
# How long to skip Gemini after a 429/quota error (seconds)
LLM_COOLDOWN_SECONDS=60

# Gemma 4 — via OpenAI-compatible endpoint (Ollama or llama.cpp llama-server)
# Example with Ollama: ollama pull gemma3:4b && ollama serve
GEMMA4_BASE_URL=http://localhost:11434/v1
GEMMA4_MODEL_NAME=gemma3:4b
GEMMA4_API_KEY=

# Qwen — via OpenAI-compatible endpoint
# Example with Ollama: ollama pull qwen2.5:7b && ollama serve
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL_NAME=qwen2.5:7b
QWEN_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# If Redis is not running, the app falls back to in-memory cache automatically.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Celery ────────────────────────────────────────────────────────────────────
# Requires Redis. If unavailable, tasks run synchronously (in-memory fallback).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── OCR ──────────────────────────────────────────────────────────────────────
# Options: mock (default) | tesseract
# For tesseract: install Tesseract OCR and set TESSERACT_CMD path
OCR_PROVIDER=mock
TESSERACT_CMD=tesseract

# ── Document Storage ──────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# ── RAG / Vector Store ────────────────────────────────────────────────────────
# Path to FAISS index directory (from BIS-RAG-master/storage/vectorstore/)
# Leave blank to disable RAG (app works without it).
VECTORSTORE_PATH=C:\Users\Admin pc\Desktop\BIS-Sahayta-main\BIS-RAG-master\storage\vectorstore
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5

# ── Session Database ──────────────────────────────────────────────────────────
# SQLite file path for chat session history
SESSION_DB_PATH=sessions.db
